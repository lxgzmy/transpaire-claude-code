# OSC API MCP - environment template.
# Copy to a location OUTSIDE the repo (or pass these via `claude mcp add --env`)
# and fill in real values. NEVER commit real credentials or server names.

# --- Required -------------------------------------------------------------
# Base URL of the OSC API for the target environment.
#   Dev  example: https://ts02.<internal-host>:53502
#   Prod example: https://<prod-host>:<port>
OSC_BASE_URL=

# OAuth client-credentials pair issued by Companion Systems for this environment.
OSC_CLIENT_ID=
OSC_CLIENT_SECRET=

# --- Optional -------------------------------------------------------------
# OpenAPI spec URL, used only by osc_list_endpoints / osc_describe_endpoint.
# Must match the environment's API version. Leave blank to disable introspection.
#   Dev example: https://<vendor-swagger-host>:53500/swagger/v7.3/swagger.json
OSC_SWAGGER_URL=

# Space-separated scopes to request. Only scopes the credential is authorised for
# are actually granted (others are silently omitted, no error), so requesting the
# full grantable set is the way to get maximum access:
#   Basic CompanionHub Inspections Liink MobileApp Orders WorkReleasingAndCompletion
OSC_SCOPES=

# Verify TLS certificates. false for internal/self-signed dev hosts; set true
# for production with a valid certificate chain.
OSC_VERIFY_TLS=false

# Master switch for write calls (POST/PUT/PATCH/DELETE). Keep false until a
# reviewed write workflow is ready. Even when true, each write still prompts.
OSC_ENABLE_WRITES=false

# Per-request timeout in seconds.
OSC_TIMEOUT=30
