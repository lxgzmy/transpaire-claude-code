# OSC API MCP - production settings template.
#
# Create production.env in this folder (shared/mcp/osc-api/) by running
# new-production-env.ps1, which asks for the values (the secret typed hidden)
# and fills this template; or copy this file and fill it in by hand. Values come
# from the company password store. production.env is git-ignored and Claude is
# blocked from reading or editing it. NEVER commit real values or host names,
# and never paste them into a chat.
#
# The server connects to the production OnSite Companion only (owner approval,
# 13 Oct 2026). The old dev settings file (.env) is not read any more.

# --- Required -------------------------------------------------------------
# Base URL of the production OSC API, e.g. https://<prod-host>:<port>
OSC_BASE_URL=

# OAuth client-credentials pair Companion Systems issued for production.
OSC_CLIENT_ID=
OSC_CLIENT_SECRET=

# --- Optional -------------------------------------------------------------
# OpenAPI spec URL for the production API version, used only by
# osc_list_endpoints / osc_describe_endpoint. Blank disables introspection.
OSC_SWAGGER_URL=

# Space-separated scopes to request. The contract intake needs Basic and
# WorkReleasingAndCompletion. Only scopes the credential is authorised for are
# granted (others are silently left out).
OSC_SCOPES=Basic WorkReleasingAndCompletion

# Verify the server's TLS certificate (default true). Set false only if IT
# confirms the production API uses an internal certificate this server does
# not trust, and say so in the PR that changes it.
OSC_VERIFY_TLS=true

# The write switch for Claude sessions is OSC_ENABLE_WRITES in the repo's
# .mcp.json, which beats this file. This line only matters for a server started
# by hand (selftest, generate_endpoints.py), which should stay read-only.
OSC_ENABLE_WRITES=false

# Per-request timeout in seconds (.mcp.json sets 120 for Claude sessions).
OSC_TIMEOUT=30

# Directories a message attachment may be read from, absolute, separated by
# ";". Default when blank: this checkout's git-ignored runtime\ folder.
OSC_UPLOAD_ROOTS=

# API version sent as the `api-version` header on every call. The production
# API refuses requests without it (HTTP 400). Default 7.3 when blank; change it
# only when Companion Systems moves the production API to a new version.
OSC_API_VERSION=7.3

# Writes are refused when the newest job in OSC is older than this many days
# (the sign of a frozen copy, not the live system). Default 30.
OSC_STALE_AFTER_DAYS=30
